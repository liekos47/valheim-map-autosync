<Project Sdk="Microsoft.NET.Sdk">
  <!-- Loads a DLL the way BepInEx ScriptEngine does (Mono.Cecil, ReadSymbols = true). refs\cecil holds the
       server's own Mono.Cecil DLLs and is not committed. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil"><HintPath>..\..\refs\cecil\Mono.Cecil.dll</HintPath></Reference>
    <Reference Include="Mono.Cecil.Pdb"><HintPath>..\..\refs\cecil\Mono.Cecil.Pdb.dll</HintPath></Reference>
    <Reference Include="Mono.Cecil.Mdb"><HintPath>..\..\refs\cecil\Mono.Cecil.Mdb.dll</HintPath></Reference>
  </ItemGroup>
</Project>
